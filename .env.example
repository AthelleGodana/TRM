# Database
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/transport_tms"

# Server
PORT=5000
NODE_ENV=development

# Auth


# Generate your own secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Client URL
CLIENT_URL=http://localhost:5173