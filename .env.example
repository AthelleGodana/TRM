# ─────────────────────────────────────────────────────────────────────────
# Transtrack Kenya configuration.
#
# - Docker Compose reads ./.env (copy this file there).
# - Running the API on the host (cd server && npm run dev) reads
#   server/.env: copy this file there too and set the three DATABASE URLs
#   to localhost.
# Never commit real values. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ─────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────
# Compose builds the URLs below from these values.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_owner_password
POSTGRES_DB=shuttle_db
DB_APP_PASSWORD=change_me_app_password
DB_SYSTEM_PASSWORD=change_me_system_password

# Host development only (Compose sets these itself). Three connections:
#  DIRECT_DATABASE_URL  owner/superuser: migrations and scripts/setup-db-roles.js
#  DATABASE_URL         application role (no superuser, no BYPASSRLS) so
#                       PostgreSQL row-level security applies to the API
#  DATABASE_URL_SYSTEM  role with BYPASSRLS, only for sign-in, the M-Pesa
#                       callback, platform admin and scheduled jobs
# Role names and passwords are taken from these URLs by npm run db:roles.
DIRECT_DATABASE_URL="postgresql://postgres:change_me_owner_password@localhost:5432/shuttle_db"
DATABASE_URL="postgresql://transtrack_app:change_me_app_password@localhost:5432/shuttle_db"
DATABASE_URL_SYSTEM="postgresql://transtrack_system:change_me_system_password@localhost:5432/shuttle_db"

# ── Server ───────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Origin of the web app (used for CORS and post-sign-in redirects).
CLIENT_URL=http://localhost:5173

# ── Sessions ─────────────────────────────────────────────────────────────
# Signs our own access tokens. Required in production.
JWT_SECRET=change_me_long_random_secret
# Access token lifetime (short; the refresh cookie renews it).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# A rotated refresh token reused within this many seconds is treated as a
# concurrent refresh from another tab rather than theft.
REFRESH_REUSE_GRACE_SECONDS=10
# Keep true. Browsers accept Secure cookies on http://localhost.
COOKIE_SECURE=true

# ── Sign in with Google ──────────────────────────────────────────────────
# OAuth 2.0 Web client ID from Google Cloud Console (see README:
# "Creating the Google OAuth client"). It is public, not a secret.
GOOGLE_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com
# Google email of the first platform SUPER_ADMIN (seeded at start-up).
SUPER_ADMIN_EMAIL=you@gmail.com
# Optional: Google email to attach to the migrated admin of the Default
# Organisation (legacy accounts had no email).
DEFAULT_ORG_ADMIN_EMAIL=
INVITATION_TTL_DAYS=14
# Temporarily re-enable username/password login during migration only.
LEGACY_PASSWORD_LOGIN=false

# ── AI Fuel Hub ──────────────────────────────────────────────────────────
# 'null' (default: no analysis) or 'http' (call ai-fuel-service). 'http' is
# used only for organisations with AI fuel analytics enabled.
FUEL_ANALYTICS_PROVIDER=null
# Compose sets the URL to http://ai-fuel-service:8000. For host development
# use docker-compose.dev.yml and http://127.0.0.1:8001.
AI_FUEL_SERVICE_URL=http://127.0.0.1:8001
# Shared secret between the API and ai-fuel-service (at least 16 chars).
AI_FUEL_SERVICE_SECRET=change_me_shared_service_secret
AI_FUEL_SERVICE_TIMEOUT_MS=30000
# Scheduled per-tenant analysis (placeholder hook). Off by default.
FUEL_ANALYSIS_JOB_ENABLED=false
FUEL_ANALYSIS_INTERVAL_MINUTES=1440
FUEL_ANALYSIS_LOOKBACK_DAYS=90

# ── M-Pesa (Daraja) ──────────────────────────────────────────────────────
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# ── Dev seed (npm run db:seed) ───────────────────────────────────────────
SEED_ADMIN_EMAIL=
SEED_DRIVER_EMAIL=
SEED_STUDENT_EMAIL=
