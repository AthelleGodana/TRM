# Test-only settings for the throwaway postgres-test container
# (cd server && npm run test:db). These credentials only
# exist inside that ephemeral container; never reuse them anywhere else.
NODE_ENV=test
# Owner/superuser: migrations and test fixtures only.
DIRECT_DATABASE_URL="postgresql://postgres:test_only_password@127.0.0.1:5433/transtrack_test"
# Application role, subject to row-level security.
DATABASE_URL="postgresql://transtrack_app:test_only_app_password@127.0.0.1:5433/transtrack_test"
# System role with BYPASSRLS (auth, M-Pesa callback, platform admin, jobs).
DATABASE_URL_SYSTEM="postgresql://transtrack_system:test_only_system_password@127.0.0.1:5433/transtrack_test"
JWT_SECRET=test_only_jwt_secret
CLIENT_URL=http://localhost:5173
GOOGLE_CLIENT_ID=test-client-id.apps.googleusercontent.com
SUPER_ADMIN_EMAIL=root@transtrack.test
REFRESH_REUSE_GRACE_SECONDS=0
