# Test-only settings for the throwaway postgres-test container
# (docker compose --profile test up -d postgres-test). These credentials only
# exist inside that ephemeral container; never reuse them anywhere else.
NODE_ENV=test
DATABASE_URL="postgresql://postgres:test_only_password@localhost:5433/transtrack_test"
JWT_SECRET=test_only_jwt_secret
CLIENT_URL=http://localhost:5173
