generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL is the application role (subject to row-level security);
// DIRECT_DATABASE_URL is the owner role that runs migrations.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// Legacy single-tenant role. Replaced by Membership.role; kept only until
// existing users have been migrated.
enum Role {
  student
  driver
  admin
}

enum OrgProfile {
  UNIVERSITY
  SCHOOL
  COMPANY
}

enum OrgStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

// Roles a user can hold inside an organisation. Which ones are allowed
// depends on the organisation's profile (see src/config/roles.js).
// SUPER_ADMIN is platform-level and lives on User.isSuperAdmin instead.
enum MemberRole {
  ORG_ADMIN
  FLEET_MANAGER
  DRIVER
  STUDENT
  PARENT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── Tenancy ────────────────────────────────────────────────────────────

model Organization {
  id                     Int        @id @default(autoincrement())
  name                   String
  slug                   String     @unique
  profile                OrgProfile
  status                 OrgStatus  @default(PENDING)
  branding               Json       @default("{}")
  fuelHubEnabled         Boolean    @default(false)
  aiFuelAnalyticsEnabled Boolean    @default(false)
  approvedAt             DateTime?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  memberships      Membership[]
  invitations      Invitation[]
  accessRequests   AccessRequest[]
  students         Student[]
  drivers          Driver[]
  routes           Route[]
  pickupPoints     PickupPoint[]
  buses            Bus[]
  slots            PickupSlot[]
  tripRosters      TripRoster[]
  vehicleLogs      VehicleLog[]
  gpsLogs          GpsLog[]
  guardians        PassengerGuardian[]
  fuelProfiles     VehicleFuelProfile[]
  fuelCards        FuelCard[]
  fuelRecords      FuelRecord[]
  calibrations     CalibrationRecord[]
  fuelAnalysisRuns FuelAnalysisRun[]
  fuelAnomalies    FuelAnomaly[]
  payments         Payment[]
}

model Membership {
  id             Int          @id @default(autoincrement())
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           MemberRole
  lastUsedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model Invitation {
  id             Int              @id @default(autoincrement())
  organizationId Int
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           MemberRole
  status         InvitationStatus @default(PENDING)
  invitedById    Int?
  invitedBy      User?            @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedById   Int?
  acceptedBy     User?            @relation("InvitationsAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)
  expiresAt      DateTime
  acceptedAt     DateTime?
  // Extra data applied on acceptance, e.g. { children: [{ firstName, lastName }] }
  // for a PARENT invited by CSV import.
  metadata       Json             @default("{}")
  createdAt      DateTime         @default(now())

  @@index([organizationId, status])
  @@index([email, status])
}

model AccessRequest {
  id             Int                 @id @default(autoincrement())
  organizationId Int
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         Int
  user           User                @relation("AccessRequests", fields: [userId], references: [id], onDelete: Cascade)
  message        String?
  status         AccessRequestStatus @default(PENDING)
  reviewedById   Int?
  reviewedBy     User?               @relation("AccessRequestsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  createdAt      DateTime            @default(now())

  @@unique([organizationId, userId])
  @@index([organizationId, status])
}

// Rotating refresh tokens. Only a SHA-256 hash of the cookie value is
// stored. Tokens issued from one sign-in share a familyId so that reuse of
// an already-rotated token can revoke the whole family.
model RefreshToken {
  id             Int       @id @default(autoincrement())
  userId         Int
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String    @unique
  familyId       String
  organizationId Int?
  expiresAt      DateTime
  rotatedAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([familyId])
  @@index([userId])
}

enum Tier {
  TOWN
  LAVINGTON
  ADAMS
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentMethod {
  MPESA
  CARD
  BANK_TRANSFER
}

// Global identity. Users sign in with Google and are identified by the
// Google "sub" claim; organisation access comes from Membership rows.
model User {
  id           Int       @id @default(autoincrement())
  googleSub    String?   @unique
  email        String?   @unique
  name         String?
  picture      String?
  isSuperAdmin Boolean   @default(false)
  lastLoginAt  DateTime?
  // Legacy password-login columns, kept until existing users have migrated.
  username     String?   @unique
  password     String?
  role         Role?
  firstName    String
  lastName     String
  createdAt    DateTime  @default(now())

  students Student[]
  drivers  Driver[]

  guardianOf             PassengerGuardian[]
  fuelRecordsCreated     FuelRecord[]        @relation("FuelRecordCreatedBy")
  calibrationsDone       CalibrationRecord[] @relation("CalibrationPerformedBy")
  anomaliesReviewed      FuelAnomaly[]       @relation("AnomalyReviewedBy")
  memberships            Membership[]
  refreshTokens          RefreshToken[]
  invitationsSent        Invitation[]        @relation("InvitationsSent")
  invitationsAccepted    Invitation[]        @relation("InvitationsAccepted")
  accessRequests         AccessRequest[]     @relation("AccessRequests")
  accessRequestsReviewed AccessRequest[]     @relation("AccessRequestsReviewed")
}

model Student {
  id             Int          @id @default(autoincrement())
  organizationId Int          @default(dbgenerated("(NULLIF(current_setting('app.current_org', true), ''))::integer"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         Int?
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Passengers without their own account (e.g. SCHOOL pupils) carry their
  // name here and are linked to parent accounts through guardians.
  firstName      String?
  lastName       String?
  address        String?
  phone          String?
  email          String?
  paymentTier    Tier         @default(TOWN)

  arrivePickupPointId Int?
  arrivePickupPoint   PickupPoint? @relation("ArrivePickup", fields: [arrivePickupPointId], references: [id])

  departPickupPointId Int?
  departPickupPoint   PickupPoint? @relation("DepartPickup", fields: [departPickupPointId], references: [id])

  routeId Int?
  route   Route? @relation(fields: [routeId], references: [id])

  payments  Payment[]
  guardians PassengerGuardian[]
  roster    TripRoster[]

  createdAt DateTime @default(now())

  @@unique([organizationId, userId])
  @@index([organizationId, routeId])
}

model Driver {
  id             Int          @id @default(autoincrement())
  organizationId Int          @default(dbgenerated("(NULLIF(current_setting('app.current_org', true), ''))::integer"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  fuelCards   FuelCard[]
  fuelRecords FuelRecord[]
  buses       Bus[]

  createdAt DateTime @default(now())

  @@unique([organizationId, userId])
}

model Route {
  id              Int          @id @default(autoincrement())
  organizationId  Int          @default(dbgenerated("(NULLIF(current_setting('app.current_org', true), ''))::integer"))
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  schoolArrival   String?
  schoolDeparture String?
  isActive        Boolean      @default(true)
  // Road route through the stops, from the routing service (OSRM) when the
  // route is saved: geometry is [[lat, lng], ...]; legs hold the distance
  // (m) and duration (s) between consecutive pinned stops.
  geometry          Json?
  distanceMeters    Float?
  durationSeconds   Float?
  legs              Json?
  geometryUpdatedAt DateTime?

  pickupPoints PickupPoint[]
  buses        Bus[]
  students     Student[]
  slots        PickupSlot[]

  createdAt DateTime @default(now())

  @@index([organizationId, isActive])
}

model PickupPoint {
  id             Int          @id @default(autoincrement())
  organizationId Int          @default(dbgenerated("(NULLIF(current_setting('app.current_org', true), ''))::integer"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  routeId        Int
  route          Route        @relation(fields: [routeId], references: [id], onDelete: Cascade)
  name           String
  tier           Tier
  lat            Float?
  lng            Float?
  order          Int          @default(0)

  studentsArriving Student[] @relation("ArrivePickup")
  studentsLeaving  Student[] @relation("DepartPickup")

  createdAt DateTime @default(now())

  @@index([organizationId, routeId])
}

enum BusStatus {
  OPERATIONAL
  IN_SERVICE
  OUT_OF_FUEL
}

model Bus {
  id             Int          @id @default(autoincrement())
  organizationId Int          @default(dbgenerated("(NULLIF(current_setting('app.current_org', true), ''))::integer"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  licensePlate   String
  capacity       Int          @default(30)
  driverId       Int?
  driver         Driver?      @relation(fields: [driverId], references: [id])
  routeId        Int?
  route          Route?       @relation(fields: [routeId], references: [id])
  status         BusStatus    @default(OPERATIONAL)

  fuelProfile   VehicleFuelProfile?
  fuelCards     FuelCard[]
  fuelRecords   FuelRecord[]
  calibrations  CalibrationRecord[]
  fuelAnomalies FuelAnomaly[]
  gpsLogs       GpsLog[]
  vehicleLogs   VehicleLog[]
  tripRosters   TripRoster[]
  slots         PickupSlot[]

  createdAt DateTime @default(now())

  @@unique([organizationId, licensePlate])
  @@index([organizationId, routeId])
  @@index([organizationId, driverId])
}

model PickupSlot {
  id             Int          @id @default(autoincrement())
  organizationId Int          @default(dbgenerated("(NULLIF(current_setting('app.current_org', true), ''))::integer"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  routeId        Int
  route          Route        @relation(fields: [routeId], references: [id], onDelete: Cascade)
  busId          Int?
  bus            Bus?         @relation(fields: [busId], references: [id])
  time           String // e.g. "06:30"
  label          String // e.g. "Morning 1"
  capacity       Int          @default(30)
  bookedCount    Int          @default(0)
  isActive       Boolean      @default(true)

  bookings TripRoster[]

  createdAt DateTime @default(now())

  @@index([organizationId, routeId])
}

enum BoardingStatus {
  PENDING
  BOARDED
  NO_SHOW
}

model TripRoster {
  id             Int            @id @default(autoincrement())
  organizationId Int            @default(dbgenerated("(NULLIF(current_setting('app.current_org', true), ''))::integer"))
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  busId          Int
  bus            Bus            @relation(fields: [busId], references: [id], onDelete: Cascade)
  slotId         Int?
  slot           PickupSlot?    @relation(fields: [slotId], references: [id])
  studentId      Int?
  student        Student?       @relation(fields: [studentId], references: [id])
  status         BoardingStatus @default(PENDING)
  tripDate       DateTime       @default(now())
  createdAt      DateTime       @default(now())

  @@index([organizationId, busId, tripDate])
  @@index([organizationId, studentId, tripDate])
}

model VehicleLog {
  id             Int          @id @default(autoincrement())
  organizationId Int          @default(dbgenerated("(NULLIF(current_setting('app.current_org', true), ''))::integer"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  busId          Int
  bus            Bus          @relation(fields: [busId], references: [id], onDelete: Cascade)
  type           String // FUEL | MAINTENANCE | SAFETY_CHECK
  fuelLiters     Float?
  fuelCost       Decimal?     @db.Decimal(10, 2)
  odometer       Int?
  notes          String?
  passed         Boolean? // for SAFETY_CHECK items
  createdAt      DateTime     @default(now())

  @@index([organizationId, busId, createdAt])
}

model GpsLog {
  id             Int          @id @default(autoincrement())
  organizationId Int          @default(dbgenerated("(NULLIF(current_setting('app.current_org', true), ''))::integer"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  busId          Int
  bus            Bus          @relation(fields: [busId], references: [id], onDelete: Cascade)
  lat            Float
  lng            Float
  // Reported by the driver's device when available.
  speedKmh       Float?
  heading        Float?
  accuracy       Float?
  recordedAt     DateTime     @default(now())

  @@index([organizationId, busId, recordedAt])
}

model Payment {
  id                Int           @id @default(autoincrement())
  organizationId    Int           @default(dbgenerated("(NULLIF(current_setting('app.current_org', true), ''))::integer"))
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  studentId         Int
  student           Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  routeId           Int?
  amount            Decimal       @db.Decimal(10, 2)
  method            PaymentMethod @default(MPESA)
  status            PaymentStatus @default(PENDING)
  mpesaReceipt      String?
  checkoutRequestId String?
  createdAt         DateTime      @default(now())

  @@index([organizationId, status])
  @@index([organizationId, studentId])
  @@index([checkoutRequestId])
}

// Links a passenger record (e.g. a SCHOOL pupil) to a PARENT member.
model PassengerGuardian {
  id             Int          @id @default(autoincrement())
  organizationId Int          @default(dbgenerated("(NULLIF(current_setting('app.current_org', true), ''))::integer"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  studentId      Int
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, studentId, userId])
  @@index([organizationId, userId])
}

// ── AI Fuel Hub (scaffold) ────────────────────────────────────────────────
// Tenant-scoped like every other operational table (RLS + same-tenant
// triggers). FuelAnalysisRun and FuelAnomaly are written by the analysis
// job once an AI provider is plugged in; until then they stay empty.

enum FuelType {
  DIESEL
  PETROL
  ELECTRIC
  HYBRID
  CNG
  LPG
}

enum FuelSource {
  MANUAL
  FUEL_CARD
}

enum FuelCardStatus {
  ACTIVE
  BLOCKED
  EXPIRED
}

enum FuelAnalysisStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum AnomalySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AnomalyStatus {
  OPEN
  CONFIRMED
  DISMISSED
}

model VehicleFuelProfile {
  id                        Int          @id @default(autoincrement())
  organizationId            Int          @default(dbgenerated("(NULLIF(current_setting('app.current_org', true), ''))::integer"))
  organization              Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  busId                     Int
  bus                       Bus          @relation(fields: [busId], references: [id], onDelete: Cascade)
  fuelType                  FuelType
  tankCapacityLitres        Decimal      @db.Decimal(8, 2)
  expectedConsumptionL100km Decimal      @db.Decimal(6, 2)
  calibrationNotes          String?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  @@unique([busId])
  @@unique([organizationId, busId])
}

// Card numbers are never stored in full; only the last four digits.
model FuelCard {
  id             Int            @id @default(autoincrement())
  organizationId Int            @default(dbgenerated("(NULLIF(current_setting('app.current_org', true), ''))::integer"))
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label          String
  provider       String?
  last4          String         @db.VarChar(4)
  busId          Int?
  bus            Bus?           @relation(fields: [busId], references: [id], onDelete: SetNull)
  driverId       Int?
  driver         Driver?        @relation(fields: [driverId], references: [id], onDelete: SetNull)
  status         FuelCardStatus @default(ACTIVE)
  monthlyLimit   Decimal?       @db.Decimal(12, 2)
  expiresAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  fuelRecords FuelRecord[]

  @@index([organizationId, status])
}

model FuelRecord {
  id                 Int          @id @default(autoincrement())
  organizationId     Int          @default(dbgenerated("(NULLIF(current_setting('app.current_org', true), ''))::integer"))
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  busId              Int
  bus                Bus          @relation(fields: [busId], references: [id], onDelete: Cascade)
  driverId           Int?
  driver             Driver?      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  fuelCardId         Int?
  fuelCard           FuelCard?    @relation(fields: [fuelCardId], references: [id], onDelete: SetNull)
  litres             Decimal      @db.Decimal(10, 2)
  pricePerLitre      Decimal?     @db.Decimal(10, 2)
  totalCost          Decimal?     @db.Decimal(12, 2)
  odometer           Int?
  station            String?
  filledAt           DateTime
  source             FuelSource   @default(MANUAL)
  receiptImageUrl    String?
  notes              String?
  createdById        Int?
  createdBy          User?        @relation("FuelRecordCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  // Set for records copied from (or mirrored from) a VehicleLog FUEL entry.
  legacyVehicleLogId Int?         @unique
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  anomalies FuelAnomaly[]

  @@index([organizationId, busId, filledAt])
  @@index([organizationId, filledAt])
  @@index([organizationId, driverId])
}

model CalibrationRecord {
  id                        Int          @id @default(autoincrement())
  organizationId            Int          @default(dbgenerated("(NULLIF(current_setting('app.current_org', true), ''))::integer"))
  organization              Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  busId                     Int
  bus                       Bus          @relation(fields: [busId], references: [id], onDelete: Cascade)
  calibratedAt              DateTime
  odometer                  Int?
  tankLevelLitres           Decimal?     @db.Decimal(8, 2)
  measuredConsumptionL100km Decimal?     @db.Decimal(6, 2)
  method                    String?
  notes                     String?
  performedById             Int?
  performedBy               User?        @relation("CalibrationPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)
  createdAt                 DateTime     @default(now())

  @@index([organizationId, busId, calibratedAt])
}

model FuelAnalysisRun {
  id              Int                @id @default(autoincrement())
  organizationId  Int                @default(dbgenerated("(NULLIF(current_setting('app.current_org', true), ''))::integer"))
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status          FuelAnalysisStatus @default(PENDING)
  provider        String
  startedAt       DateTime           @default(now())
  finishedAt      DateTime?
  recordsAnalyzed Int                @default(0)
  anomaliesFound  Int                @default(0)
  error           String?

  anomalies FuelAnomaly[]

  @@index([organizationId, startedAt])
}

model FuelAnomaly {
  id             Int              @id @default(autoincrement())
  organizationId Int              @default(dbgenerated("(NULLIF(current_setting('app.current_org', true), ''))::integer"))
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runId          Int?
  run            FuelAnalysisRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  busId          Int?
  bus            Bus?             @relation(fields: [busId], references: [id], onDelete: SetNull)
  fuelRecordId   Int?
  fuelRecord     FuelRecord?      @relation(fields: [fuelRecordId], references: [id], onDelete: SetNull)
  type           String
  severity       AnomalySeverity
  score          Float
  explanation    Json
  status         AnomalyStatus    @default(OPEN)
  reviewedById   Int?
  reviewedBy     User?            @relation("AnomalyReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime         @default(now())

  @@index([organizationId, status, createdAt])
  @@index([organizationId, busId])
}
