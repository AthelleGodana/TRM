{
  "name": "tms-server",
  "version": "1.0.0",
  "description": "Transport Management System — Express API server",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "test": "vitest run",
    "test:db": "docker compose -f ../docker-compose.yml --profile test up -d --wait postgres-test"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.7.4"
  },
  "devDependencies": {
    "prisma": "^5.10.0",
    "socket.io-client": "^4.7.5",
    "supertest": "^7.0.0",
    "vitest": "^2.1.9"
  }
}
