{
  "name": "tms-server",
  "version": "1.0.0",
  "description": "Transport Management System — Express API server",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "routes:geometry": "node scripts/route-geometry.js",
    "test": "vitest run",
    "test:db": "docker compose -f ../docker-compose.test.yml up -d --wait",
    "db:roles": "node scripts/setup-db-roles.js",
    "db:deploy": "prisma migrate deploy && node scripts/setup-db-roles.js"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "google-auth-library": "^9.15.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "socket.io": "^4.7.4"
  },
  "devDependencies": {
    "pg": "^8.13.1",
    "prisma": "^5.10.0",
    "socket.io-client": "^4.7.5",
    "supertest": "^7.0.0",
    "vitest": "^2.1.9"
  }
}
